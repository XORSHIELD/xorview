{
  "name": "xorview",
  "version": "0.2.0",
  "private": true,
  "description": "XorView v2: original-code Electron overlay assistant (live mic transcription, screen context, AI suggestions).",
  "repository": {
    "type": "git",
    "url": "https://github.com/XORSHIELD/xorview.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "lint": "node scripts/lint.js",
    "build": "node scripts/build.js",
    "predist": "node scripts/build.js",
    "dist": "electron-builder --publish never",
    "smoke": "node scripts/smoke.js",
    "make-icon": "node scripts/make-icon.js",
    "test": "node --test core/settings.test.js core/providers.test.js core/screen.test.js core/audio.test.js core/suggest.test.js core/profile.test.js core/cv.test.js core/voicestudio.test.js scripts/scripts.test.js test/main.test.js test/renderer.test.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.xorview.app",
    "productName": "XorView",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "core/**",
      "assets/**",
      "package.json",
      "node_modules/pdf-parse/index.js",
      "node_modules/pdf-parse/package.json",
      "node_modules/pdf-parse/lib/pdf-parse.js",
      "node_modules/pdf-parse/lib/pdf.js/v1.10.100/**",
      "!**/*.test.js",
      "!**/.test-tmp-*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
